# Twelve-digit AWS account ID; explicit input avoids synth-time account lookups.
PLATFORM_ACCOUNT=111111111111
# AWS region for the deployment environment.
PLATFORM_REGION=us-east-1
# Two distinct AZ names confirmed available in the deployment account.
PLATFORM_AVAILABILITY_ZONES=us-east-1a,us-east-1b
# Lowercase environment name in resource and /wander/<name>/v1 SSM paths.
PLATFORM_ENV=demo
# HTTPS origin of the eventual static UI, without a trailing slash.
PLATFORM_SITE_ORIGIN=https://wander.example
# Valid ACM certificate ARN in PLATFORM_REGION for the GraphQL ALB.
PLATFORM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:111111111111:certificate/00000000-0000-4000-8000-000000000000
# Existing IAM principal allowed to assume the separate deployment role.
PLATFORM_DEPLOY_PRINCIPAL_ARN=arn:aws:iam::111111111111:role/wander-deployer
# Unique Cognito hosted-login prefix; use a real available value for deployment.
PLATFORM_COGNITO_DOMAIN_PREFIX=wander-demo-example
# Optional GitHub owner/name whose protected deploy environment may assume the deployment role.
PLATFORM_GITHUB_REPOSITORY=
