# Non-secret inputs to deploy-all.sh; never automatically loaded.
# Required foundation account/region/env, two AZs, HTTPS site and regional graph certificate.
PLATFORM_ACCOUNT=111111111111
PLATFORM_REGION=us-east-1
# Must equal PLATFORM_REGION when set; preflight rejects a mismatch (AWS_DEFAULT_REGION too).
AWS_REGION=us-east-1
PLATFORM_ENV=demo
PLATFORM_AVAILABILITY_ZONES=us-east-1a,us-east-1b
PLATFORM_SITE_ORIGIN=https://wander.example
PLATFORM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:111111111111:certificate/00000000-0000-4000-8000-000000000000
# Required existing deployment trust principal and globally unique Cognito prefix.
PLATFORM_DEPLOY_PRINCIPAL_ARN=arn:aws:iam::111111111111:role/wander-deployer
PLATFORM_COGNITO_DOMAIN_PREFIX=wander-demo-example
# Optional GitHub owner/name for OIDC deployment from its protected <env> environment; blank
# keeps the deployment role assumable only by PLATFORM_DEPLOY_PRINCIPAL_ARN.
PLATFORM_GITHUB_REPOSITORY=
# Required separate site certificate in us-east-1 and public API HTTPS origin.
UI_CERTIFICATE_ARN=arn:aws:acm:us-east-1:111111111111:certificate/00000000-0000-4000-8000-000000000000
DEPLOY_GRAPH_ORIGIN=https://api.wander.example
# Optional graph providers; blank or mock keeps the offline adapter.
# Weather (mock|wttr) and places (mock|overpass) need no account or secret.
API_WEATHER_PROVIDER=mock
API_PLACES_PROVIDER=mock
# Events (mock|ticketmaster) and LLM (mock|openai|anthropic) read their keys from the named
# Secrets Manager entries /wander/<env>/v1/secrets/<vendor>; a selected LLM needs its model.
API_EVENTS_PROVIDER=mock
API_LLM_PROVIDER=mock
API_LLM_MODEL=
